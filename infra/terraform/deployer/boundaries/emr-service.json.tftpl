{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "V2UseTaggedNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:RunInstances",
        "ec2:CreateFleet",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:${region}:${acct}:subnet/*",
        "arn:aws:ec2:${region}:${acct}:security-group/*",
        "arn:aws:ec2:${region}:${acct}:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}",
          "aws:ResourceTag/environment": "${env}",
          "aws:ResourceTag/for-use-with-amazon-emr-managed-policies": "true",
          "aws:ResourceTag/project": "scholarchain"
        }
      }
    },
    {
      "Sid": "V2CreateNewWithEmrRequestTag",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateNetworkInterface",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:${region}:${acct}:instance/*",
        "arn:aws:ec2:${region}:${acct}:volume/*",
        "arn:aws:ec2:${region}:${acct}:network-interface/*",
        "arn:aws:ec2:${region}:${acct}:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/for-use-with-amazon-emr-managed-policies": "true",
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "V2ExistingLaunchDependencies",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet"
      ],
      "Resource": [
        "arn:aws:ec2:${region}::image/ami-*",
        "arn:aws:ec2:${region}:${acct}:key-pair/*",
        "arn:aws:ec2:${region}:${acct}:capacity-reservation/*",
        "arn:aws:ec2:${region}:${acct}:dedicated-host/*",
        "arn:aws:ec2:${region}:${acct}:fleet/*",
        "arn:aws:ec2:${region}:${acct}:placement-group/EMR_*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "V2ManageTaggedInstancesAndEnis",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteNetworkInterface",
        "ec2:ModifyInstanceAttribute",
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "arn:aws:ec2:${region}:${acct}:network-interface/*",
        "arn:aws:ec2:${region}:${acct}:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}",
          "aws:ResourceTag/environment": "${env}",
          "aws:ResourceTag/for-use-with-amazon-emr-managed-policies": "true",
          "aws:ResourceTag/project": "scholarchain"
        }
      }
    },
    {
      "Sid": "V2ManageSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:ec2:${region}:${acct}:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}",
          "aws:ResourceTag/environment": "${env}",
          "aws:ResourceTag/for-use-with-amazon-emr-managed-policies": "true",
          "aws:ResourceTag/project": "scholarchain"
        }
      }
    },
    {
      "Sid": "V2TagOnCreateOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:${region}:${acct}:instance/*",
        "arn:aws:ec2:${region}:${acct}:volume/*",
        "arn:aws:ec2:${region}:${acct}:network-interface/*",
        "arn:aws:ec2:${region}:${acct}:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}",
          "ec2:CreateAction": [
            "RunInstances",
            "CreateNetworkInterface",
            "CreateSecurityGroup"
          ]
        }
      }
    },
    {
      "Sid": "V2DeleteTagsOnEmrTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:${region}:${acct}:instance/*",
        "arn:aws:ec2:${region}:${acct}:volume/*",
        "arn:aws:ec2:${region}:${acct}:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}",
          "aws:ResourceTag/environment": "${env}",
          "aws:ResourceTag/for-use-with-amazon-emr-managed-policies": "true",
          "aws:ResourceTag/project": "scholarchain"
        }
      }
    },
    {
      "Sid": "EmrServiceRoleEc2DescribeCeiling",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAccountAttributes",
        "ec2:DescribeCapacityReservations",
        "ec2:DescribeDhcpOptions",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribePlacementGroups",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumeStatus",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcs"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "PassInstanceProfileRoleToEc2",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::${acct}:role/${mp}-emr-ec2"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ProjectKeyForEbsEncryption",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo",
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws:kms:${region}:${acct}:key/*"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": "alias/${mp}-data"
        }
      }
    }
  ]
}
