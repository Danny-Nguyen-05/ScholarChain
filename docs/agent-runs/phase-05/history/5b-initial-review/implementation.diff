@@ -0,0 +1,88 @@
+{
+  "schemaVersion": "scholarchain.resolution.v1",
+  "decisionId": "resolution-decision:8feff09cb07ee68eef11c679e139e135a75e3e69950585b68598ea9f3fef8b33",
+  "pair": {
+    "schemaVersion": "scholarchain.resolution.v1",
+    "pairId": "resolution-pair:32c83838c7bcf409215f65a5e256dd8535fe0e7bdbef5f9aa28f469d07d06138",
+    "entityType": "Researcher",
