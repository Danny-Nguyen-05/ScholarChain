diff --git a/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/Adjudication.scala b/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/Adjudication.scala
new file mode 100644
index 0000000..e27ad88
--- /dev/null
+++ b/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/Adjudication.scala
@@ -0,0 +1,433 @@
+package edu.uic.cs441.scholarchain.entityresolution
+
+import edu.uic.cs441.scholarchain.core.*
+import java.nio.charset.StandardCharsets.UTF_8
+import java.util.concurrent.{Callable, Executors, ThreadFactory, TimeUnit, TimeoutException}
+import scala.util.Try
+import upickle.default.{ReadWriter, write, writeJs}
+
+final case class AdjudicationRequest(
+    schemaVersion: String,
+    requestHash: String,
+    pairId: String,
+    entityType: ResolutionEntityType,
+    sourceId: String,
+    targetId: String,
+    inputEvidenceHash: String,
+    policyHash: String,
+    configHash: String,
+    promptVersion: String,
+    promptHash: String,
+    responseSchemaVersion: String,
+    responseSchemaHash: String,
+    provider: String,
+    model: String,
+    modelVersion: String,
+    generationSettings: Map[String, String],
+    mode: String,
+    evidence: Vector[EvidenceRecord],
+    features: Vector[ResolutionFeature],
+    identifiers: Vector[IdentifierEvidence]
+) derives ReadWriter
+final case class AdjudicationResponse(
+    schemaVersion: String,
+    requestHash: String,
+    pairId: String,
+    sourceId: String,
+    targetId: String,
+    inputEvidenceHash: String,
+    policyHash: String,
+    outcome: String,
+    reasonCodes: Vector[String],
+    evidenceRefs: Vector[String],
+    rationale: String,
+    reportedConfidence: Double,
+    fieldRefs: Vector[String]
+) derives ReadWriter
+final case class AdjudicationTrace(
+    pairId: String,
+    status: String,
+    attempts: Int,
+    cacheHit: Boolean,
+    request: Option[AdjudicationRequest],
+    response: Option[AdjudicationResponse],
+    error: Option[String]
+) derives ReadWriter
+
+/** No network implementation is supplied or selectable in 5B. Tests inject bounded fake adapters.
+  */
+trait AdjudicationAdapter {
+  def provider: String
+  def model: String
+  def modelVersion: String
+  def respond(request: AdjudicationRequest): String
+}
+final class DeterministicFakeAdapter(val model: String, val modelVersion: String)
+    extends AdjudicationAdapter {
+  val provider = "deterministic-fake"
+  var calls: Int = 0
+  def respond(request: AdjudicationRequest): String = {
+    calls += 1
+    write(
+      AdjudicationResponse(
+        Adjudication.responseSchema,
+        request.requestHash,
+        request.pairId,
+        request.sourceId,
+        request.targetId,
+        request.inputEvidenceHash,
+        request.policyHash,
+        "abstain",
+        Vector("INSUFFICIENT_EVIDENCE"),
+        Vector.empty,
+        "Deterministic fake fixture abstains; no model ran.",
+        0.0,
+        Vector.empty
+      )
+    )
+  }
+}
+object Adjudication {
+  val requestSchema = "scholarchain.adjudication-request.v1"
+  val responseSchema = "scholarchain.adjudication-response.v1"
+  val promptVersion = "er-adjudication-offline-v1"
+  def prompt: String = ResourceText.read("adjudication/prompt.v1.txt")
+  def schemaText: String = ResourceText.read("adjudication/response.schema.v1.json")
+  def validateRequest(
+      request: AdjudicationRequest,
+      config: ResolutionConfig
+  ): Either[String, AdjudicationRequest] = Try {
+    ResolutionConfig.validate(config).fold(e => throw new IllegalArgumentException(e), identity)
+    require(
+      request.schemaVersion == requestSchema && request.mode == "fake",
+      "unsupported request schema or mode"
+    )
+    require(
+      request.requestHash == StrictJson.hash(request.copy(requestHash = "")),
+      "request hash mismatch"
+    )
+    require(
+      request.configHash == config.fingerprint && request.provider == config.adjudication.provider && request.model == config.adjudication.model && request.modelVersion == config.adjudication.modelVersion && request.generationSettings == config.adjudication.generationSettings,
+      "request effective config/provider mismatch"
+    )
+    require(
+      request.promptVersion == promptVersion && request.promptHash == StableIds.sha256Hex(
+        prompt
+      ) && request.responseSchemaVersion == responseSchema && request.responseSchemaHash == StableIds
+        .sha256Hex(schemaText),
+      "request prompt/schema mismatch"
+    )
+    require(
+      request.pairId.matches("resolution-pair:[0-9a-f]{64}") && Vector(
+        request.sourceId,
+        request.targetId
+      ).forall(
+        _.matches("resolution-endpoint:[0-9a-f]{64}")
+      ) && request.sourceId != request.targetId && Vector(
+        request.inputEvidenceHash,
+        request.policyHash
+      ).forall(_.matches("[0-9a-f]{64}")),
+      "invalid request IDs/hashes"
+    )
+    require(
+      request.evidence.nonEmpty && request.evidence
+        .map(_.ref)
+        .distinct
+        .size == request.evidence.size && request.evidence.forall(e =>
+        e.ref == ResolutionInput.evidenceFor(e.kind, e.payload) && e.sha256 == StableIds.sha256Hex(
+          StrictJson.canonical(e.payload)
+        )
+      ),
+      "invalid request evidence hashes"
+    )
+    require(
+      request.features.map(_.name).distinct.size == request.features.size && request.features
+        .forall(f =>
+          f.value.isDefined != f.missingReason.isDefined && f.value.forall(
+            _.isFinite
+          ) && f.evidenceRefs.forall(request.evidence.map(_.ref).toSet)
+        ),
+      "invalid request feature evidence"
+    )
+    require(
+      write(request).getBytes(UTF_8).length.toLong + prompt
+        .getBytes(UTF_8)
+        .length <= config.adjudication.maxRequestBytes,
+      "request byte bound exceeded"
+    )
+    request
+  }.toEither.left.map(_.getMessage)
+  def request(
+      candidate: DerivedPair,
+      input: ResolutionInput,
+      policy: ResolutionPolicy,
+      config: ResolutionConfig,
+      features: Vector[ResolutionFeature],
+      evidence: Map[String, EvidenceRecord]
+  ): Either[String, AdjudicationRequest] = Try {
+    val pair = candidate.pair
+    val raw = AdjudicationRequest(
+      requestSchema,
+      "",
+      pair.pairId,
+      pair.entityType,
+      ResolutionIds.endpointId(pair.left),
+      ResolutionIds.endpointId(pair.right),
+      input.inputEvidenceHash,
+      policy.fingerprint,
+      config.fingerprint,
+      promptVersion,
+      StableIds.sha256Hex(prompt),
+      responseSchema,
+      StableIds.sha256Hex(schemaText),
+      config.adjudication.provider,
+      config.adjudication.model,
+      config.adjudication.modelVersion,
+      config.adjudication.generationSettings,
+      "fake",
+      candidate.evidenceRefs.sorted.map(r =>
+        evidence.getOrElse(r, throw new IllegalArgumentException("missing request evidence"))
+      ),
+      features,
+      FeatureExtractor.identifiers(pair.left, input) ++ FeatureExtractor.identifiers(
+        pair.right,
+        input
+      )
+    )
+    val req = raw.copy(requestHash = StrictJson.hash(raw))
+    require(
+      write(req)
+        .getBytes(UTF_8)
+        .length + prompt.getBytes(UTF_8).length <= config.adjudication.maxRequestBytes,
+      "request byte bound exceeded"
+    )
+    req
+  }.toEither.left.map(_.getMessage)
+  def validateResponse(
+      text: String,
+      request: AdjudicationRequest,
+      config: ResolutionConfig
+  ): Either[String, AdjudicationResponse] =
+    if (text.getBytes(UTF_8).length > config.adjudication.maxResponseBytes)
+      Left("response byte bound exceeded")
+    else
+      StrictJson.parse[AdjudicationResponse](text).flatMap { r =>
+        Try {
+          require(
+            r.schemaVersion == responseSchema && r.requestHash == request.requestHash && r.pairId == request.pairId && r.sourceId == request.sourceId && r.targetId == request.targetId && r.inputEvidenceHash == request.inputEvidenceHash && r.policyHash == request.policyHash,
+            "response request identity mismatch"
+          )
+          require(Set("accept", "reject", "abstain")(r.outcome), "invalid response outcome")
+          require(
+            r.reasonCodes.nonEmpty && r.reasonCodes.distinct == r.reasonCodes && r.reasonCodes.size <= config.adjudication.maxReasonCodes && r.reasonCodes
+              .forall(
+                Set(
+                  "SUPPORTED_SAME_IDENTITY",
+                  "SUPPORTED_DIFFERENT_IDENTITY",
+                  "INSUFFICIENT_EVIDENCE"
+                )
+              ),
+            "invalid model reason codes"
+          )
+          require(
+            r.evidenceRefs.distinct == r.evidenceRefs && r.evidenceRefs.forall(
+              request.evidence.map(_.ref).toSet
+            ),
+            "fabricated response evidence refs"
+          )
+          require(
+            r.outcome == "abstain" || r.evidenceRefs.nonEmpty,
+            "decisive response requires cited evidence"
+          )
+          require(
+            r.fieldRefs.distinct == r.fieldRefs && r.fieldRefs.size <= config.adjudication.maxFieldRefs,
+            "invalid cited field count"
+          )
+          require(
+            r.outcome == "abstain" || r.fieldRefs.nonEmpty,
+            "decisive response requires cited input fields"
+          )
+          r.fieldRefs.foreach { citation =>
+            val parts = citation.split("#", -1)
+            require(
+              parts.length == 2 && parts(1).startsWith("/") && r.evidenceRefs.contains(parts(0)),
+              "field citation must identify a cited evidence record and JSON pointer"
+            )
+            var value = request.evidence.find(_.ref == parts(0)).get.payload
+            parts(1).drop(1).split("/", -1).foreach { raw =>
+              require(!raw.matches(".*~(?![01]).*"), "invalid JSON pointer escape")
+              val token = raw.replace("~1", "/").replace("~0", "~")
+              value = value match {
+                case o: ujson.Obj =>
+                  o.value
+                    .getOrElse(token, throw new IllegalArgumentException("fabricated input field"))
+                case a: ujson.Arr =>
+                  require(token.matches("0|[1-9][0-9]*"), "invalid input field array index");
+                  val i = token.toInt;
+                  require(i < a.value.size, "input field array index out of range"); a(i)
+                case _ => throw new IllegalArgumentException("input field pointer traverses scalar")
+              }
+            }
+            require(value != ujson.Null, "missing input field cannot be cited as evidence")
+          }
+          require(
+            r.rationale.nonEmpty && r.rationale.length <= config.adjudication.maxRationaleCharacters && !r.rationale
+              .exists(c => c < ' ' && c != '\n' && c != '\t'),
+            "invalid rationale length/control characters"
+          )
+          require(
+            r.reportedConfidence.isFinite && r.reportedConfidence >= 0 && r.reportedConfidence <= 1,
+            "model confidence must be in [0,1]"
+          )
+          r
+        }.toEither.left.map(_.getMessage)
+      }
+}
+
+/** One per run. Budgets include failed attempts; disabled never invokes or consults an adapter. */
+final class OfflineAdjudicator(
+    config: ResolutionConfig,
+    adapter: AdjudicationAdapter,
+    cache: Option[java.nio.file.Path]
+) {
+  private var attempts = 0
+  private var inputAllowance = 0L
+  private var outputAllowance = 0L
+  private var fused = false
+  def calls: Int = attempts
+  def adjudicate(request: AdjudicationRequest): AdjudicationTrace = {
+    Adjudication.validateRequest(request, config) match {
+      case Left(error) =>
+        return AdjudicationTrace(
+          request.pairId,
+          "REQUEST_INVALID",
+          0,
+          false,
+          Some(request),
+          None,
+          Some(error)
+        )
+      case Right(_) => ()
+    }
+    if (fused)
+      return AdjudicationTrace(
+        request.pairId,
+        "ADAPTER_NOT_TERMINATED",
+        0,
+        false,
+        Some(request),
+        None,
+        Some("prior adapter ignored cancellation; no further calls allowed")
+      )
+    if (
+      adapter.provider != config.adjudication.provider || adapter.model != config.adjudication.model || adapter.modelVersion != config.adjudication.modelVersion
+    )
+      return AdjudicationTrace(
+        request.pairId,
+        "ADAPTER_CONFIG_MISMATCH",
+        0,
+        false,
+        Some(request),
+        None,
+        Some("adapter identity differs from explicit config")
+      )
+    val cached =
+      cache.map(dir => AdjudicationCache.read(dir, request, config)).getOrElse(Right(None))
+    cached match {
+      case Left(e) =>
+        return AdjudicationTrace(
+          request.pairId,
+          "CACHE_INVALID",
+          0,
+          false,
+          Some(request),
+          None,
+          Some(e)
+        )
+      case Right(Some(r)) =>
+        return AdjudicationTrace(request.pairId, "CACHE_HIT", 0, true, Some(request), Some(r), None)
+      case _ => ()
+    }
+    val requestBytes =
+      write(request).getBytes(UTF_8).length + Adjudication.prompt.getBytes(UTF_8).length
+    var lastError = "provider failure"; var localAttempts = 0
+    while (localAttempts <= config.adjudication.maxRetries) {
+      // UTF-8 byte counts are conservative token reservations, not measured usage.
+      if (
+        attempts >= config.adjudication.maxRequests || inputAllowance + requestBytes > config.adjudication.maxInputTokens || outputAllowance + config.adjudication.maxResponseBytes > config.adjudication.maxOutputTokens
+      )
+        return AdjudicationTrace(
+          request.pairId,
+          "BUDGET_EXHAUSTED",
+          localAttempts,
+          false,
+          Some(request),
+          None,
+          Some("offline request/token reservation budget exhausted")
+        )
+      attempts += 1; localAttempts += 1; inputAllowance += requestBytes;
+      outputAllowance += config.adjudication.maxResponseBytes
+      val executor = Executors.newSingleThreadExecutor(new ThreadFactory {
+        def newThread(r: Runnable): Thread = {
+          val t = new Thread(r, "er-offline-fake"); t.setDaemon(true); t
+        }
+      })
+      val task = executor.submit(new Callable[String] {
+        def call(): String = adapter.respond(request)
+      })
+      var terminated = true
+      val result =
+        try
+          Adjudication.validateResponse(
+            task.get(config.adjudication.timeoutMs.toLong, TimeUnit.MILLISECONDS),
+            request,
+            config
+          )
+        catch {
+          case _: TimeoutException => task.cancel(true); Left("ADAPTER_TIMEOUT")
+          case e: Exception        => Left(Option(e.getMessage).getOrElse("ADAPTER_FAILURE"))
+        } finally {
+          executor.shutdownNow();
+          terminated =
+            executor.awaitTermination(config.adjudication.timeoutMs.toLong, TimeUnit.MILLISECONDS)
+        }
+      if (!terminated) {
+        fused = true;
+        return AdjudicationTrace(
+          request.pairId,
+          "ADAPTER_NOT_TERMINATED",
+          localAttempts,
+          false,
+          Some(request),
+          None,
+          Some("adapter ignored cancellation; retries and subsequent calls disabled")
+        )
+      }
+      result match {
+        case Right(response) =>
+          val cacheResult = cache
+            .map(dir => AdjudicationCache.write(dir, request, response, config))
+            .getOrElse(Right(()))
+          return AdjudicationTrace(
+            request.pairId,
+            if (cacheResult.isRight) "VALIDATED_FAKE" else "CACHE_WRITE_FAILED",
+            localAttempts,
+            false,
+            Some(request),
+            Some(response),
+            cacheResult.left.toOption
+          )
+        case Left(error) => lastError = error
+      }
+    }
+    AdjudicationTrace(
+      request.pairId,
+      "ADJUDICATION_FAILED",
+      localAttempts,
+      false,
+      Some(request),
+      None,
+      Some(lastError)
+    )
+  }
+}
diff --git a/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/AdjudicationCache.scala b/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/AdjudicationCache.scala
new file mode 100644
index 0000000..e07dba5
--- /dev/null
+++ b/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/AdjudicationCache.scala
@@ -0,0 +1,93 @@
+package edu.uic.cs441.scholarchain.entityresolution
+
+import edu.uic.cs441.scholarchain.core.StableIds
+import java.nio.charset.StandardCharsets.UTF_8
+import java.nio.file.{Files, Path, StandardCopyOption, StandardOpenOption}
+import java.util.UUID
+import scala.util.Try
+import upickle.default.{ReadWriter, write}
+
+final case class CachedAdjudication(
+    schemaVersion: String,
+    cacheKey: String,
+    request: AdjudicationRequest,
+    response: AdjudicationResponse,
+    responseHash: String
+) derives ReadWriter
+object AdjudicationCache {
+  def key(request: AdjudicationRequest): String = StrictJson.hash(request)
+  private def location(dir: Path, request: AdjudicationRequest): Path =
+    dir.resolve("fake").resolve(key(request) + ".json")
+  private def safe(dir: Path): Unit = {
+    val absolute = dir.toAbsolutePath.normalize
+    var p: Path = absolute
+    while (p != null) {
+      require(!Files.isSymbolicLink(p), "symlink in cache path"); p = p.getParent
+    }
+    if (Files.exists(absolute)) require(Files.isDirectory(absolute), "cache directory required")
+  }
+  def read(
+      dir: Path,
+      request: AdjudicationRequest,
+      config: ResolutionConfig
+  ): Either[String, Option[AdjudicationResponse]] = Try {
+    safe(dir); require(request.mode == "fake", "5B cache only supports fake mode")
+    val path = location(dir, request); safe(path.getParent)
+    if (!Files.exists(path)) None
+    else {
+      val text = StrictJson
+        .file(
+          path,
+          config.adjudication.maxRequestBytes.toLong + config.adjudication.maxResponseBytes + 16384
+        )
+        .fold(e => throw new IllegalArgumentException(e), identity)
+      val c = StrictJson
+        .parse[CachedAdjudication](text)
+        .fold(e => throw new IllegalArgumentException(e), identity)
+      require(
+        c.schemaVersion == "scholarchain.adjudication-cache.v1" && c.cacheKey == key(
+          request
+        ) && c.request == request && c.responseHash == StrictJson.hash(c.response),
+        "cache identity/hash mismatch"
+      )
+      Some(
+        Adjudication
+          .validateResponse(upickle.default.write(c.response), request, config)
+          .fold(e => throw new IllegalArgumentException(e), identity)
+      )
+    }
+  }.toEither.left.map(_.getMessage)
+  def write(
+      dir: Path,
+      request: AdjudicationRequest,
+      response: AdjudicationResponse,
+      config: ResolutionConfig
+  ): Either[String, Unit] = Try {
+    safe(dir); require(request.mode == "fake", "5B cache only supports fake mode")
+    Adjudication
+      .validateResponse(upickle.default.write(response), request, config)
+      .fold(e => throw new IllegalArgumentException(e), identity)
+    val path = location(dir, request); Files.createDirectories(path.getParent)
+    require(!Files.isSymbolicLink(path.getParent), "symlink in cache mode directory")
+    if (Files.exists(path))
+      require(
+        read(dir, request, config).contains(Some(response)),
+        "existing cache entry differs or is corrupt"
+      )
+    else {
+      val temp = path.resolveSibling(path.getFileName.toString + ".partial-" + UUID.randomUUID())
+      val data = upickle.default.write(
+        CachedAdjudication(
+          "scholarchain.adjudication-cache.v1",
+          key(request),
+          request,
+          response,
+          StrictJson.hash(response)
+        )
+      )
+      Files.writeString(temp, data, UTF_8, StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE)
+      Files.move(temp, path, StandardCopyOption.ATOMIC_MOVE)
+    }
+    ()
+  }.toEither.left.map(_.getMessage)
+}
diff --git a/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/CandidateBuilder.scala b/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/CandidateBuilder.scala
new file mode 100644
index 0000000..5a61834
--- /dev/null
+++ b/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/CandidateBuilder.scala
@@ -0,0 +1,222 @@
+package edu.uic.cs441.scholarchain.entityresolution
+
+import edu.uic.cs441.scholarchain.core.*
+import java.nio.charset.StandardCharsets.UTF_8
+import scala.collection.mutable
+import scala.util.Try
+import upickle.default.{ReadWriter, writeJs}
+
+final case class DerivedPair(
+    pair: ResolutionPair,
+    contributingCandidates: Vector[CandidateBlockRef],
+    evidenceRefs: Vector[String]
+) derives ReadWriter
+final case class CandidatePopulation(
+    pairs: Vector[DerivedPair],
+    diagnostics: Vector[InputDiagnostic],
+    derivedEvidence: Vector[EvidenceRecord]
+) derives ReadWriter
+
+object CandidateBuilder {
+  def build(input: ResolutionInput, config: ResolutionConfig): Either[String, CandidatePopulation] =
+    Try {
+      ResolutionConfig.validate(config).fold(e => throw new IllegalArgumentException(e), identity)
+      val bounds = config.blocking
+      val pairs = mutable.Map.empty[String, DerivedPair]
+      val diagnostics = mutable.Map.empty[String, Long].withDefaultValue(0L)
+      val derived = mutable.Map.empty[String, EvidenceRecord]
+      val perMention = mutable.Map.empty[String, Int].withDefaultValue(0)
+      val oversizePairs = mutable.Set.empty[String]
+      var attempted = 0L
+      def diagnostic(code: String, count: Long = 1): Unit = diagnostics(code) += count
+      def add(
+          a: ResolutionEndpoint,
+          b: ResolutionEndpoint,
+          refs: Vector[CandidateBlockRef],
+          evidence: Vector[String]
+      ): Unit = {
+        ResolutionIds.pair(ResolutionIds.entityType(a), a, b) match {
+          case Left(_) => diagnostic("SELF_OR_INCOMPATIBLE_PAIR")
+          case Right(pair) =>
+            if (oversizePairs(pair.pairId)) diagnostic("PAIR_ALREADY_OVERSIZE")
+            else if (pairs.contains(pair.pairId)) {
+              val old = pairs(pair.pairId)
+              val mergedRefs = (old.evidenceRefs ++ evidence).distinct.sorted
+              val available = input.evidence ++ derived
+              if (
+                mergedRefs
+                  .map(r => available(r).payload.render().getBytes(UTF_8).length.toLong)
+                  .sum > bounds.maxEvidenceBytesPerPair
+              ) {
+                pairs.remove(pair.pairId); oversizePairs += pair.pairId;
+                diagnostic("PAIR_AGGREGATE_EVIDENCE_BYTE_BOUND")
+              } else
+                pairs(pair.pairId) = old.copy(
+                  contributingCandidates = (old.contributingCandidates ++ refs).distinct.sortBy(c =>
+                    (c.candidateId, c.blockKey)
+                  ),
+                  evidenceRefs = mergedRefs
+                )
+            } else if (pairs.size >= bounds.maxPairsPerRun) diagnostic("RUN_PAIR_BOUND")
+            else {
+              val keys = Vector(a, b).collect { case e @ ResolutionEndpoint.Mention(_, _) =>
+                ResolutionIds.endpointId(e)
+              }
+              val cross = ResolutionIds.observation(a) != ResolutionIds.observation(b)
+              if (
+                cross && keys
+                  .exists(k => perMention(k) >= bounds.maxCrossPublicationPairsPerMention)
+              ) diagnostic("MENTION_PAIR_BOUND")
+              else {
+                val sourceRefs = (input.refs(a) ++ input.refs(b) ++ evidence).distinct.sorted
+                val available = input.evidence ++ derived
+                val bytes = sourceRefs
+                  .map(r => available(r).payload.render().getBytes(UTF_8).length.toLong)
+                  .sum
+                if (bytes > bounds.maxEvidenceBytesPerPair) diagnostic("PAIR_EVIDENCE_BYTE_BOUND")
+                else {
+                  pairs(pair.pairId) = DerivedPair(
+                    pair,
+                    refs.distinct.sortBy(c => (c.candidateId, c.blockKey)),
+                    sourceRefs
+                  )
+                  if (cross) keys.foreach(k => perMention(k) += 1)
+                }
+              }
+            }
+        }
+      }
+      def endpoint(o: CandidateObservation): Option[ResolutionEndpoint] = {
+        val ref = ResolutionObservationRef(o.source, o.sourceRecordId, o.datasetSnapshot)
+        input.workByRef
+          .get(ref)
+          .map(w => ResolutionEndpoint.Work(ref, w.workId))
+          .orElse(
+            input.profileByRef.get(ref).map(p => ResolutionEndpoint.OrcidProfile(ref, p.orcid))
+          )
+          .orElse(
+            input.activityByRef
+              .get(ref)
+              .filter(_.activityKind == OrcidActivityKind.Work)
+              .map(a => ResolutionEndpoint.OrcidWorkActivity(ref, a.observedWorkId))
+          )
+      }
+      input.candidates.groupBy(_.blockKey).toVector.sortBy(_._1).foreach { case (_, rows) =>
+        val members = rows.flatMap(c => Vector(c.left, c.right)).distinct.size
+        if (
+          members > bounds.maxMembersPerBlock || rows
+            .map(c => (c.left, c.right))
+            .distinct
+            .size > bounds.maxPairsPerBlock
+        ) diagnostic("PREP_OVERSIZE_BLOCK_ROWS", rows.size)
+        else if (attempted + rows.size > bounds.maxPairAttempts)
+          diagnostic("PAIR_ATTEMPT_BOUND", rows.size)
+        else
+          rows.sortBy(_.candidateId).foreach { c =>
+            attempted += 1
+            val ea = endpoint(c.left); val eb = endpoint(c.right)
+            (ea, eb) match {
+              case (Some(a), Some(b))
+                  if ResolutionIds.entityType(a) == ResolutionIds.entityType(b) =>
+                add(
+                  a,
+                  b,
+                  Vector(CandidateBlockRef(c.candidateId, c.blockKey)),
+                  Vector(ResolutionInput.evidenceFor("match-candidate", writeJs(c)))
+                )
+              case (Some(_), Some(_)) => diagnostic("UNSUPPORTED_CROSS_ENTITY_PROFILE_WORK")
+              case _                  => diagnostic("UNSUPPORTED_NONWORK_ORCID_ACTIVITY")
+            }
+          }
+      }
+      // Emit pair-level skip counts separately from row counts, so multiblock duplication is visible.
+      val unsupported = input.candidates
+        .groupBy(c =>
+          Vector(c.left, c.right)
+            .map(o => ujson.Arr(o.source.wire, o.sourceRecordId, o.datasetSnapshot).render())
+            .sorted
+            .mkString("\n")
+        )
+        .values
+      unsupported.foreach { rows =>
+        val c = rows.head;
+        (endpoint(c.left), endpoint(c.right)) match {
+          case (Some(a), Some(b)) if ResolutionIds.entityType(a) != ResolutionIds.entityType(b) =>
+            diagnostic("UNSUPPORTED_DISTINCT_CROSS_ENTITY_PAIR")
+          case (None, _) | (_, None) => diagnostic("UNSUPPORTED_DISTINCT_NONWORK_PAIR")
+          case _                     => ()
+        }
+      }
+      val memberships = mutable.ArrayBuffer.empty[(String, ResolutionEndpoint)]
+      def block(key: String, e: ResolutionEndpoint): Unit = {
+        require(memberships.size < bounds.maxBlockMemberships, "block membership bound exceeded")
+        memberships += key -> e
+      }
+      input.endpoints
+        .filter(ResolutionIds.entityType(_) == ResolutionEntityType.Researcher)
+        .foreach { e =>
+          val names = e match {
+            case ResolutionEndpoint.Mention(_, _) => input.mention(e).toVector.map(_.nameText)
+            case ResolutionEndpoint.OrcidProfile(ref, _) =>
+              input.profileByRef(ref).displayName.toVector ++ input.profileByRef(ref).otherNames
+            case _ => Vector.empty
+          }
+          names
+            .flatMap(n => Normalization.nameVariants(n).toVector)
+            .filter(_.nonEmpty)
+            .distinct
+            .sorted
+            .foreach(n => block("er-name:" + StableIds.sha256Hex(n), e))
+          names
+            .map(Normalization.nameTokens)
+            .filter(_.nonEmpty)
+            .map(t => t.last + ":" + t.head.head)
+            .distinct
+            .sorted
+            .foreach(n => block("er-initial:" + StableIds.sha256Hex(n), e))
+          input.authority(e).foreach { case (ns, value) =>
+            block("er-id:" + ns.wire + ":" + value, e)
+          }
+          input
+            .mention(e)
+            .flatMap(_.observedOpenAlexAuthorId)
+            .foreach(id => block("er-openalex-author:" + id, e))
+        }
+      memberships.toVector.groupBy(_._1).toVector.sortBy(_._1).foreach { case (key, items) =>
+        val members = items.map(_._2).distinct.sortBy(ResolutionIds.endpointKey)
+        val possible = members.size.toLong * (members.size - 1) / 2
+        if (members.size > bounds.maxMembersPerBlock || possible > bounds.maxPairsPerBlock)
+          diagnostic("DERIVED_OVERSIZE_BLOCK", possible)
+        else if (attempted + possible > bounds.maxPairAttempts)
+          diagnostic("PAIR_ATTEMPT_BOUND", possible)
+        else if (pairs.size >= bounds.maxPairsPerRun) diagnostic("RUN_PAIR_BOUND", possible)
+        else
+          for (i <- members.indices; j <- (i + 1) until members.size) {
+            attempted += 1
+            val a = members(i); val b = members(j)
+            if (ResolutionIds.observation(a) != ResolutionIds.observation(b)) {
+              val pair = ResolutionIds.pair(ResolutionEntityType.Researcher, a, b).toOption.get
+              val candidateId = "match-candidate:" + StableIds.sha256Hex(
+                ujson.Arr("er-derived-candidate-v1", key, pair.pairId).render()
+              )
+              val payload = ujson.Obj(
+                "schemaVersion" -> "scholarchain.er-derived-candidate.v1",
+                "candidateId" -> candidateId,
+                "blockKey" -> key,
+                "pair" -> writeJs(pair)
+              )
+              val ev =
+                ResolutionInput.record("derived-candidate", payload, "derived-by-er-blocking-v1")
+              derived(ev.ref) = ev
+              add(a, b, Vector(CandidateBlockRef(candidateId, key)), Vector(ev.ref))
+            }
+          }
+      }
+      val used = pairs.valuesIterator.flatMap(_.evidenceRefs).toSet
+      CandidatePopulation(
+        pairs.values.toVector.sortBy(_.pair.pairId),
+        diagnostics.toVector.sortBy(_._1).map((k, n) => InputDiagnostic(k, n, Vector.empty)),
+        derived.valuesIterator.filter(e => used(e.ref)).toVector.sortBy(_.ref)
+      )
+    }.toEither.left.map(e => Option(e.getMessage).getOrElse(e.getClass.getSimpleName))
+}
diff --git a/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/FeatureExtractor.scala b/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/FeatureExtractor.scala
new file mode 100644
index 0000000..3055b61
--- /dev/null
+++ b/modules/entity-resolution/src/main/scala/edu/uic/cs441/scholarchain/entityresolution/FeatureExtractor.scala
@@ -0,0 +1,190 @@
+package edu.uic.cs441.scholarchain.entityresolution
+
+import edu.uic.cs441.scholarchain.core.*
+
+object FeatureExtractor {
+  val names: Vector[String] = ResolutionPolicy.featureNames.toVector.sorted
+  def identifiers(
+      endpoint: ResolutionEndpoint,
+      input: ResolutionInput
+  ): Vector[IdentifierEvidence] = {
+    val ref = ResolutionIds.observation(endpoint); val refs = input.refs(endpoint)
+    val raw: Vector[(String, String, String)] = endpoint match {
+      case ResolutionEndpoint.Work(_, _) =>
+        val w = input.workByRef(ref)
+        w.doi.toVector.map(v => ("doi", v, "preferred.doi")) ++ w.arxivId.toVector.map(v =>
+          ("arxiv", v, "preferred.arxiv")
+        ) ++
+          w.observedIdentifiers.flatMap(id =>
+            IdentifierRules.role(id.namespace).map(ns => (ns, id.value, id.namespace))
+          ) ++
+          w.sourceLinks.map(l =>
+            ("repository-url", l.value, "sourceLinks." + l.name)
+          ) ++ w.externalUrl.toVector.map(v => ("repository-url", v, "externalUrl")) ++
+          (if (w.source == SourceType.OpenAlex)
+             Vector(("openalex-work", w.sourceRecordId, "native-record"))
+           else if (w.source == SourceType.Crossref)
+             Vector(("doi", w.sourceRecordId, "native-record"))
+           else Vector.empty)
+      case ResolutionEndpoint.Mention(_, _) =>
+        val m = input.mention(endpoint).get;
+        m.observedOrcid.toVector.map(v =>
+          ("orcid", v, "observedOrcid")
+        ) ++ m.observedOpenAlexAuthorId.toVector.map(v =>
+          ("openalex-author", v, "observedOpenAlexAuthorId")
+        )
+      case ResolutionEndpoint.OrcidProfile(_, _) =>
+        val p = input.profileByRef(ref);
+        Vector(("orcid", p.orcid, "profile.orcid")) ++ p.externalIds.flatMap(id =>
+          IdentifierRules
+            .role(id.namespace)
+            .map(ns => (ns, id.value, "profile.externalIds." + id.namespace))
+        )
+      case ResolutionEndpoint.OrcidWorkActivity(_, _) =>
+        val a = input.activityByRef(ref);
+        a.observedDoi.toVector.map(v => ("doi", v, "observedDoi")) ++ a.workReferences.flatMap(id =>
+          IdentifierRules
+            .role(id.externalIdType)
+            .map(ns => (ns, id.value, "workReferences." + id.relationship.getOrElse("unknown")))
+        )
+    }
+    raw.map { case (ns, value, role) =>
+      val n = IdentifierRules.normalize(ns, value);
+      IdentifierEvidence(
+        ns,
+        value,
+        n.toOption,
+        Normalization.version,
+        role,
+        Set("doi", "arxiv", "orcid")(ns) && n.toOption.exists(v =>
+          input
+            .authority(endpoint)
+            .exists((a, x) => a.wire == ns && x == v.replaceFirst("v[0-9]+$", ""))
+        ),
+        refs,
+        n.left.toOption
+      )
+    }
+  }
+  def extract(
+      candidate: DerivedPair,
+      input: ResolutionInput,
+      policy: ResolutionPolicy
+  ): Vector[ResolutionFeature] = {
+    val pair = candidate.pair; val a = pair.left; val b = pair.right;
+    val refs = (input.refs(a) ++ input.refs(b)).distinct.sorted
+    val wa = input.parentWork(a); val wb = input.parentWork(b)
+    def title(e: ResolutionEndpoint): Option[String] = input
+      .parentWork(e)
+      .map(_.title)
+      .orElse(input.activityByRef.get(ResolutionIds.observation(e)).flatMap(_.title))
+    def year(e: ResolutionEndpoint): Option[Int] = input
+      .parentWork(e)
+      .flatMap(_.year)
+      .orElse(input.activityByRef.get(ResolutionIds.observation(e)).flatMap(_.publicationYear))
+    def name(e: ResolutionEndpoint): Option[String] = input
+      .mention(e)
+      .map(_.nameText)
+      .orElse(input.profileByRef.get(ResolutionIds.observation(e)).flatMap(_.displayName))
+    def similarity(x: Option[String], y: Option[String]): Option[Double] = for (
+      xx <- x; yy <- y; s <- Normalization.similarity(xx, yy)
+    ) yield s
+    def authorNames(w: Option[WorkRecord]): Set[String] = w.toVector
+      .flatMap(_.authors)
+      .map(m => Normalization.nameTokens(m.nameText).sorted.mkString(" "))
+      .filter(_.nonEmpty)
+      .toSet
+    def coauthors(e: ResolutionEndpoint): Set[String] = input
+      .parentWork(e)
+      .toVector
+      .flatMap(_.authors)
+      .filterNot(m => input.mention(e).exists(_.mentionId == m.mentionId))
+      .map(m => Normalization.nameTokens(m.nameText).sorted.mkString(" "))
+      .filter(_.nonEmpty)
+      .toSet
+    val samePublication = (for (x <- wa; y <- wb)
+      yield x.workId == y.workId).contains(true) || (for (x <- wa; y <- wb) yield {
+      val ex = ResolutionEndpoint.Work(ResolutionInput.ref(x.provenance), x.workId);
+      val ey = ResolutionEndpoint.Work(ResolutionInput.ref(y.provenance), y.workId)
+      input.authority(ex).intersect(input.authority(ey)).nonEmpty
+    }).contains(true)
+    def affiliations(e: ResolutionEndpoint): Set[String] = input
+      .mention(e)
+      .toVector
+      .flatMap { m =>
+        val ref = ResolutionIds.observation(e)
+        input.affiliations
+          .filter(a => a.mentionId == m.mentionId && ResolutionInput.ref(a.provenance) == ref)
+          .flatMap(a =>
+            a.ror.toVector.map("ror:" + _) ++ a.ringgold.toVector.map(
+              "ringgold:" + _
+            ) ++ a.organizationName.toVector.map(n => "name:" + Normalization.folded(n))
+          ) ++
+          input.enrichments
+            .filter(a =>
+              a.mentionId.contains(m.mentionId) && ResolutionInput
+                .ref(a.provenance) == ref && a.targetKind == EnrichmentTargetKind.Institution
+            )
+            .map(_.targetId)
+      }
+      .toSet
+    val ia = identifiers(a, input).flatMap(i => i.normalized.map(i.namespace -> _)).toSet
+    val ib = identifiers(b, input).flatMap(i => i.normalized.map(i.namespace -> _)).toSet
+    val researcher = pair.entityType == ResolutionEntityType.Researcher
+    val values: Map[String, Option[Double]] = Map(
+      "title" -> (if (!researcher) similarity(title(a), title(b)) else None),
+      "name" -> (if (researcher) (for (x <- name(a); y <- name(b)) yield {
+                   val xx = Normalization.nameTokens(x).toSet;
+                   val yy = Normalization.nameTokens(y).toSet;
+                   Normalization.jaccard(xx, yy).getOrElse(0.0)
+                 })
+                 else None),
+      "initials" -> (if (researcher) (for (
+                       x <- name(a); y <- name(b); s <- Normalization.initialsCompatible(x, y)
+                     ) yield s)
+                     else None),
+      "authorOverlap" -> (if (!researcher) Normalization.jaccard(authorNames(wa), authorNames(wb))
+                          else None),
+      "coauthorOverlap" -> (if (researcher && !samePublication)
+                              Normalization.jaccard(coauthors(a), coauthors(b))
+                            else None),
+      "authorOrder" -> (if (researcher)
+                          (for (x <- input.mention(a); y <- input.mention(b))
+                            yield 1.0 / (1.0 + math.abs(x.ordinal.toLong - y.ordinal.toLong)))
+                        else None),
+      "affiliation" -> (if (researcher) Normalization.jaccard(affiliations(a), affiliations(b))
+                        else None),
+      "yearCompatibility" -> (for (x <- year(a); y <- year(b))
+        yield math.max(
+          0.0,
+          1.0 - math
+            .abs(x.toLong - y.toLong)
+            .toDouble / policy.forEntity(pair.entityType).yearToleranceYears
+        )),
+      "venue" -> (for (x <- wa.flatMap(_.venueId); y <- wb.flatMap(_.venueId))
+        yield if (x == y) 1.0 else 0.0),
+      "identifier" -> (if (ia.map(_._1).intersect(ib.map(_._1)).isEmpty) None
+                       else Some(if (ia.intersect(ib).nonEmpty) 1.0 else 0.0)),
+      "citationNeighborhood" -> None,
+      "sourceReliability" -> Some(
+        math.min(
+          policy.sourceReliability(ResolutionIds.observation(a).source.wire),
+          policy.sourceReliability(ResolutionIds.observation(b).source.wire)
+        )
+      )
+    )
+    names.map(n =>
+      ResolutionFeature(
+        n,
+        values(n),
+        if (values(n).isDefined) None
+        else
+          Some(
+            if (n == "citationNeighborhood") "NOT_EXPORTED_BY_PREPARATION"
+            else "NOT_APPLICABLE_OR_SOURCE_EVIDENCE_MISSING"
+          ),
+        if (values(n).isDefined) refs else Vector.empty
+      )
+    )
+  }
+}
