+          Vector.empty,
+          Vector(activity),
+          Vector(candidateWith(Some("work:doi:10.1000/wrong")))
+        )
+        .isLeft
+    )
+    assert(
+      ResolutionInput
+        .create(Vector(w), Vector.empty, Vector(activity), Vector(candidateWith(Some(w.workId))))
+        .isRight
+    )
+  }
+
+}
diff --git a/tests/src/test/scala/edu/uic/cs441/scholarchain/independent/IndependentCandidateDerivationSpec.scala b/tests/src/test/scala/edu/uic/cs441/scholarchain/independent/IndependentCandidateDerivationSpec.scala
new file mode 100644
index 0000000..4c5dcc6
