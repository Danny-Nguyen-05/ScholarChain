+  test("malformed and out-of-cap caller budgets reject before any backend call") {
+    withStub { (uri, seen) =>
+      val remote =
+        new RemoteService(uri, "synthetic-budget-token", config, new ServiceMetrics, "graph")
+      try {
+        for (value <- Vector("0", "-1", "not-a-number", "5001")) {
