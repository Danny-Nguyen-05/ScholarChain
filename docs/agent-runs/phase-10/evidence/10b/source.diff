+package edu.uic.cs441.scholarchain.services
+
+import edu.uic.cs441.scholarchain.storage.*
+import edu.uic.cs441.scholarchain.core.*
+
+private[services] object PortResult {
+  def read[A](r: StorageResult[A]): Either[ApiError, A] = r match {
+    case StorageResult.Missing =>
+      Left(ApiError(404, "NOT_FOUND", "The requested record was not found."))
+    case other => StorageResult.value(other).toRight(ApiError.downstream)
+  }
+}
+final class EvidenceApi(
+    store: EvidenceBundleStore,
+    audits: RuntimeAuditStore,
+    sessions: Option[QuerySessionStore] = None
+) {
+  def evidence(id: String): Either[ApiError, ApiReply] =
+    PortResult.read(store.getItem(id)).map { item =>
+      ApiReply(
+        200,
+        ujson.Obj(
+          "evidenceId" -> item.evidenceId,
+          "evidenceType" -> item.evidenceType.wire,
+          "workId" -> upickle.default.writeJs(item.workId),
+          "sourceDataset" -> item.provenance.source.wire,
+          "sourceRecordId" -> item.provenance.sourceRecordId,
+          "snapshot" -> item.provenance.datasetSnapshot,
+          "sourceUri" -> item.sourceUri,
+          "text" -> upickle.default.writeJs(item.text),
+          "textS3Uri" -> (if (item.sourceUri.startsWith("s3://")) ujson.Str(item.sourceUri)
+                          else ujson.Null),
+          "graphPath" -> upickle.default.writeJs(item.graphPath),
+          "chunkId" -> upickle.default.writeJs(item.chunkId),
+          "score" -> item.score,
+          "provenance" -> upickle.default.writeJs(item.provenance),
+          "supportingContent" -> item.runtime.map(upickle.default.writeJs(_)).getOrElse(ujson.Null)
+        )
+      )
+    }
+  def queryEvidence(id: String): Either[ApiError, ApiReply] =
+    PortResult.read(audits.get(id)).map { audit =>
+      ApiReply(
+        200,
+        ujson.Obj(
+          "queryId" -> id,
+          "evidenceIds" -> ujson.Arr.from(audit.record.toVector.flatMap(_.evidenceIds))
+        )
+      )
+    }
+  def explain(id: String): Either[ApiError, ApiReply] =
+    PortResult.read(audits.get(id)).map { audit =>
+      val record = audit.record
+      // Only observable, persisted audit fields are projected. Neither attempted model prose nor
+      // hidden prompts/reasoning are returned. Missing measurements remain null, never guessed.
+      ApiReply(
+        200,
+        ujson.Obj(
+          "queryId" -> audit.queryId,
+          "traceId" -> audit.traceId,
+          "queryPlan" -> record.map(r => upickle.default.writeJs(r.plan)).getOrElse(ujson.Null),
+          "stagesExecuted" -> sessions
+            .flatMap(s => StorageResult.value(s.get(id)))
+            .flatMap(s =>
+              try ujson.read(s.payload).obj.get("observedStages")
+              catch { case _: Exception => None }
+            )
+            .getOrElse(ujson.Null),
+          "stageFailures" -> upickle.default.writeJs(audit.stageFailures),
+          "promptVersions" -> ujson.Arr.from(audit.modelUsage.map(_.promptVersion).distinct),
+          "modelVersions" -> upickle.default.writeJs(audit.modelUsage),
+          "evidenceIds" -> ujson.Arr.from(record.toVector.flatMap(_.evidenceIds)),
+          "scoreComponents" -> ujson.Arr.from(
+            record.toVector
+              .flatMap(_.evidenceIds)
+              .flatMap(id => StorageResult.value(store.getItem(id)))
+              .map(item =>
+                ujson.Obj(
+                  "evidenceId" -> item.evidenceId,
+                  "score" -> item.score,
+                  "source" -> "persisted-evidence-item"
+                )
+              )
+          ),
+          "counters" -> ujson.Obj(
+            "latencyMillis" -> audit.latencyMillis,
+            "retries" -> ujson.Null,
+            "cacheHits" -> ujson.Null,
+            "attemptedClaims" -> record.map(_.attemptedClaims.size).getOrElse(0),
+            "verifiedClaims" -> record.toVector
+              .flatMap(_.verification.claims)
+              .count(_.verdict == ClaimVerdict.Verified),
+            "rejectedClaims" -> record.map(_.verification.rejectedClaims.size).getOrElse(0)
+          ),
+          "verificationStatus" -> record
+            .map(r => r.verification.overallStatus.wire)
+            .getOrElse(audit.outcome),
+          "verification" -> record
+            .map(r => upickle.default.writeJs(r.verification.claims))
+            .getOrElse(ujson.Arr()),
+          "outcome" -> audit.outcome,
+          "reason" -> upickle.default.writeJs(audit.reason),
+          "metricVersions" -> ujson.Arr.from(record.toVector.flatMap(_.metricVersions)),
+          "graphRunIds" -> ujson.Arr.from(record.toVector.flatMap(_.graphRunIds))
+        )
+      )
+    }
+}
diff --git a/modules/services/src/main/scala/edu/uic/cs441/scholarchain/services/GraphApi.scala b/modules/services/src/main/scala/edu/uic/cs441/scholarchain/services/GraphApi.scala
new file mode 100644
index 0000000..ebd66fd
--- /dev/null
+++ b/modules/services/src/main/scala/edu/uic/cs441/scholarchain/services/GraphApi.scala
@@ -0,0 +1,316 @@
+package edu.uic.cs441.scholarchain.services
+
+import edu.uic.cs441.scholarchain.core.*
+import edu.uic.cs441.scholarchain.storage.*
+import java.nio.charset.StandardCharsets.UTF_8
+import java.util.Base64
+import javax.crypto.Mac
+import javax.crypto.spec.SecretKeySpec
+import scala.util.boundary
+import scala.util.control.NonFatal
+
+/** Directed immutable snapshot supplied by composition. The older GraphReader neighbor port has
+  * neither direction nor snapshot identity and cannot satisfy this stronger public contract.
+  */
+trait GraphSnapshot {
+  def snapshotId: String
+  def node(id: String): StorageResult[GraphNode]
+  def edges(id: String, window: String): StorageResult[Vector[GraphEdge]]
+  def metrics(id: String, window: String): StorageResult[ResearcherMetricRecord]
+}
+final class InMemoryGraphSnapshot(
+    val snapshotId: String,
+    nodes: Vector[GraphNode],
+    edges: Vector[GraphEdge],
+    metricStore: ResearcherMetricStore = new InMemoryResearcherMetricStore
+) extends GraphSnapshot {
+  require(snapshotId.nonEmpty && nodes.map(_.nodeId).distinct.size == nodes.size)
+  def node(id: String): StorageResult[GraphNode] =
+    nodes.find(_.nodeId == id).map(StorageResult.Found(_)).getOrElse(StorageResult.Missing)
+  def edges(id: String, window: String): StorageResult[Vector[GraphEdge]] =
+    StorageResult.Found(
+      edges
+        .filter(e => e.fromId == id || e.toId == id)
+        .filter(e => e.properties.find(_.name == "windowId").forall(_.value == window))
+    )
+  def metrics(id: String, window: String): StorageResult[ResearcherMetricRecord] =
+    metricStore.get(id, window)
+}
+final case class GraphApiConfig(
+    defaultDirection: String = "both",
+    defaultDepth: Int = 1,
+    maxDepth: Int = 3,
+    defaultLimit: Int = 50,
+    maxLimit: Int = 200,
+    timeoutMs: Long = 5000,
+    defaultWindow: String = "all-years",
+    maxScannedEdges: Int = 10000,
+    maxVisitedNodes: Int = 2000,
+    maxCursorChars: Int = 4096,
+    cursorKey: String = java.util.UUID.randomUUID().toString
+) {
+  require(
+    Set("in", "out", "both")(
+      defaultDirection
+    ) && defaultDepth > 0 && defaultDepth <= maxDepth && maxDepth <= 3
+  )
+  require(defaultLimit > 0 && defaultLimit <= maxLimit && maxLimit <= 200 && timeoutMs > 0)
+  require(
+    defaultWindow.nonEmpty && maxScannedEdges > 0 && maxVisitedNodes > 0 && maxCursorChars > 0 && cursorKey.nonEmpty
+  )
+}
+final class GraphApi(snapshot: GraphSnapshot, val config: GraphApiConfig = GraphApiConfig())
+    extends GraphEndpoints {
+  private val edgeTypes =
+    Set("COAUTHORED_WITH", "AUTHORED", "HAS_TOPIC", "AFFILIATED_WITH", "PUBLISHED_IN")
+  private val boundaryConfig = ServiceConfig(
+    Auth.sha256("graph-boundary-placeholder"),
+    Auth.sha256("graph-boundary-internal-placeholder"),
+    downstreamTimeoutMs = config.timeoutMs,
+    downstreamMaxAttempts = 1
+  )
+  private val boundaryClient =
+    new DownstreamClient(boundaryConfig, new CircuitBreaker(Int.MaxValue, config.timeoutMs))
+  private def timed[A](context: RequestContext, timeout: Long)(
+      body: => Either[ApiError, A]
+  ): Either[ApiError, A] = {
+    // One call wraps the complete expansion so slow node/edge adapters cannot extend the aggregate deadline.
+    boundaryClient.callWithin("GET", context, timeout)(_ => body)
+  }
+  private def signature(value: String): String = {
+    val mac = Mac.getInstance("HmacSHA256")
+    mac.init(new SecretKeySpec(config.cursorKey.getBytes(UTF_8), "HmacSHA256"))
+    Base64.getUrlEncoder.withoutPadding().encodeToString(mac.doFinal(value.getBytes(UTF_8)))
+  }
+  private def encode(offset: Int, binding: String): String = {
+    val p = ujson.Obj("offset" -> offset, "binding" -> binding).render()
+    Base64.getUrlEncoder.withoutPadding().encodeToString(p.getBytes(UTF_8)) + "." + signature(p)
+  }
+  private def decode(cursor: String, binding: String): Either[ApiError, Int] = try {
+    if (cursor.length > config.maxCursorChars) return Left(ApiError.invalid)
+    val parts = cursor.split("\\.", -1)
+    if (parts.length != 2) return Left(ApiError.invalid)
+    val p = new String(Base64.getUrlDecoder.decode(parts(0)), UTF_8)
+    if (
+      !java.security.MessageDigest.isEqual(signature(p).getBytes(UTF_8), parts(1).getBytes(UTF_8))
+    ) return Left(ApiError.invalid)
+    val value = ujson.read(p)
+    if (value("binding").str != binding || !value("offset").num.isWhole || value("offset").num < 0)
+      Left(ApiError.invalid)
+    else Right(value("offset").num.toInt)
+  } catch { case NonFatal(_) => Left(ApiError.invalid) }
+  def node(id: String, context: RequestContext): Either[ApiError, ApiReply] =
+    timed(context, config.timeoutMs) {
+      PortResult
+        .read(snapshot.node(id))
+        .map(n =>
+          ApiReply(
+            200,
+            ujson.Obj(
+              "nodeId" -> n.nodeId,
+              "snapshot" -> snapshot.snapshotId,
+              "node" -> upickle.default.writeJs(n)
+            )
+          )
+        )
+    }
+  def neighbors(
+      id: String,
+      params: Map[String, String],
+      context: RequestContext
+  ): Either[ApiError, ApiReply] = boundary {
+    try {
+      if (
+        !params.keySet.subsetOf(
+          Set("direction", "depth", "limit", "edgeTypes", "window", "timeoutMs", "cursor")
+        )
+      ) boundary.break(Left(ApiError.invalid))
+      val direction = params.getOrElse("direction", config.defaultDirection)
+      val depth = params.get("depth").map(_.toInt).getOrElse(config.defaultDepth)
+      val limit = params.get("limit").map(_.toInt).getOrElse(config.defaultLimit)
+      val timeout = params.get("timeoutMs").map(_.toLong).getOrElse(config.timeoutMs)
+      val window = params.getOrElse("window", config.defaultWindow)
+      val types = params.get("edgeTypes").map(_.split(",", -1).toSet).getOrElse(edgeTypes)
+      if (
+        !Set("in", "out", "both")(
+          direction
+        ) || depth < 1 || depth > config.maxDepth || limit < 1 || limit > config.maxLimit || timeout < 1 || timeout > config.timeoutMs || window.isEmpty || !types
+          .subsetOf(edgeTypes) || types.isEmpty
+      ) boundary.break(Left(ApiError.invalid))
+      val binding = Auth.sha256(
+        ujson
+          .Arr(
+            id,
+            snapshot.snapshotId,
+            direction,
+            depth,
+            limit,
+            window,
+            ujson.Arr.from(types.toVector.sorted),
+            timeout
+          )
+          .render()
+      )
+      val offset = params
+        .get("cursor")
+        .map(decode(_, binding))
+        .getOrElse(Right(0))
+        .fold(e => boundary.break(Left(e)), identity)
+      timed(context, timeout) {
+        PortResult.read(snapshot.node(id)).flatMap { _ =>
+          val expires = System.nanoTime() + timeout * 1000000L
+          var frontier = Vector(id); var visited = Set(id); var scanned = 0; var level = 0
+          var items = Vector.empty[ujson.Value]; var seenEdges = Set.empty[String]
+          var error: Option[ApiError] = None
+          while (frontier.nonEmpty && level < depth && error.isEmpty) {
+            level += 1; var next = Vector.empty[String]
+            frontier.sorted.foreach { current =>
+              if (System.nanoTime() >= expires) error = Some(ApiError.timeout)
+              else if (error.isEmpty) PortResult.read(snapshot.edges(current, window)) match {
+                case Left(e) => error = Some(e)
+                case Right(edges) =>
+                  scanned += edges.size
+                  if (scanned > config.maxScannedEdges)
+                    error = Some(
+                      ApiError(
+                        422,
+                        "GRAPH_SCAN_CAP",
+                        "Graph exploration exceeds the configured scan cap."
+                      )
+                    )
+                  else
+                    edges.sortBy(_.edgeId).filter(e => types(e.edgeType.wire)).foreach { edge =>
+                      val follow =
+                        if (direction == "out" && edge.fromId == current) Some(edge.toId)
+                        else if (direction == "in" && edge.toId == current) Some(edge.fromId)
+                        else if (direction == "both")
+                          Some(if (edge.fromId == current) edge.toId else edge.fromId)
+                        else None
+                      follow.foreach { target =>
+                        if (!seenEdges(edge.edgeId)) {
+                          items :+= ujson.Obj(
+                            "nodeId" -> target,
+                            "edgeId" -> edge.edgeId,
+                            "edgeType" -> edge.edgeType.wire,
+                            "depth" -> level,
+                            "fromId" -> edge.fromId,
+                            "toId" -> edge.toId,
+                            "provenance" -> upickle.default.writeJs(edge.provenance)
+                          )
+                          seenEdges += edge.edgeId
+                        }
+                        if (!visited(target)) { visited += target; next :+= target }
+                      }
+                    }
+              }
+              if (visited.size > config.maxVisitedNodes)
+                error = Some(
+                  ApiError(
+                    422,
+                    "GRAPH_NODE_CAP",
+                    "Graph exploration exceeds the configured node cap."
+                  )
+                )
+            }
+            frontier = next.distinct
+          }
+          if (System.nanoTime() >= expires) error = Some(ApiError.timeout)
+          error.map(Left(_)).getOrElse {
+            if (offset > items.size) Left(ApiError.invalid)
+            else
+              Right(
+                ApiReply(
+                  200,
+                  ujson.Obj(
+                    "nodeId" -> id,
+                    "snapshot" -> snapshot.snapshotId,
+                    "direction" -> direction,
+                    "depth" -> depth,
+                    "items" -> ujson.Arr.from(items.slice(offset, offset + limit)),
+                    "cursor" -> (if (offset + limit < items.size)
+                                   ujson.Str(encode(offset + limit, binding))
+                                 else ujson.Null)
+                  )
+                )
+              )
+          }
+        }
+      }
+    } catch { case b: boundary.Break[?] => throw b; case NonFatal(_) => Left(ApiError.invalid) }
+  }
+  def metrics(id: String, window: String, context: RequestContext): Either[ApiError, ApiReply] =
+    timed(context, config.timeoutMs) {
+      PortResult
+        .read(snapshot.metrics(id, window))
+        .map(m =>
+          ApiReply(
+            200,
+            ujson.Obj(
+              "researcherId" -> id,
+              "window" -> window,
+              "record" -> ujson.read(m.payloadJson),
+              "qualifications" -> ujson.read(m.qualificationsJson),
+              "metricVersion" -> m.metricVersion,
+              "runId" -> m.runId
+            )
+          )
+        )
+    }
+  def paths(params: Map[String, String], context: RequestContext): Either[ApiError, ApiReply] = {
+    val to = params.getOrElse("to", "")
+    if (to.isEmpty || !params.keySet.subsetOf(Set("from", "to", "maxDepth", "window")))
+      Left(ApiError.invalid)
+    else {
+      val from = params.getOrElse("from", "")
+      val p = Map(
+        "depth" -> params.getOrElse("maxDepth", config.maxDepth.toString),
+        "limit" -> config.maxLimit.toString,
+        "window" -> params.getOrElse("window", config.defaultWindow)
+      )
+      neighbors(from, p, context).flatMap { reply =>
+        val items = reply.body("items").arr.toVector
+        val maxDepth = p("depth").toInt
+        var frontier = Vector((Vector(from), Vector.empty[String]));
+        var found: Option[(Vector[String], Vector[String])] = None
+        var level = 0
+        var visited = Set(from)
+        while (frontier.nonEmpty && found.isEmpty && level <= maxDepth) {
+          found = frontier.find(_._1.last == to)
+          if (found.isEmpty && level < maxDepth) frontier = frontier.flatMap { (ns, es) =>
+            items.filter(x => x("fromId").str == ns.last || x("toId").str == ns.last).flatMap {
+              item =>
+                val n = if (item("fromId").str == ns.last) item("toId").str else item("fromId").str
+                if (visited(n)) None
+                else { visited += n; Some((ns :+ n, es :+ item("edgeId").str)) }
+            }
+          }
+          else frontier = Vector.empty
+          level += 1
+        }
+        val nodes = found.map(_._1).getOrElse(Vector.empty)
+        val edgeIds = found.map(_._2).getOrElse(Vector.empty)
+        if (reply.body("cursor") != ujson.Null)
+          return Left(
+            ApiError(422, "PATH_EXPANSION_TRUNCATED", "The bounded path expansion is incomplete.")
+          )
+        Right(
+          ApiReply(
+            200,
+            ujson.Obj(
+              "snapshot" -> snapshot.snapshotId,
+              "paths" -> (if (found.nonEmpty)
+                            ujson.Arr(
+                              ujson.Obj(
+                                "nodeIds" -> ujson.Arr.from(nodes),
+                                "edgeIds" -> ujson.Arr.from(edgeIds)
+                              )
+                            )
+                          else ujson.Arr())
+            )
+          )
+        )
+      }
+    }
+  }
+  def close(): Unit = boundaryClient.close()
+}
diff --git a/modules/services/src/main/scala/edu/uic/cs441/scholarchain/services/OfflineComposition.scala b/modules/services/src/main/scala/edu/uic/cs441/scholarchain/services/OfflineComposition.scala
new file mode 100644
index 0000000..3ef7cd8
--- /dev/null
+++ b/modules/services/src/main/scala/edu/uic/cs441/scholarchain/services/OfflineComposition.scala
@@ -0,0 +1,266 @@
+package edu.uic.cs441.scholarchain.services
+
+import edu.uic.cs441.scholarchain.core.*
+import edu.uic.cs441.scholarchain.rag.*
+import edu.uic.cs441.scholarchain.storage.*
+import edu.uic.cs441.scholarchain.storage.fakes.{
+  InMemoryIndexedEvidenceBundleStore,
+  InMemoryRuntimeAuditStore
+}
+import java.nio.file.{Path, Files}
+
+/** Explicit synthetic offline composition, never selected as an implicit production fallback. It
+  * runs the real retrieval/synthesis/verification/audit path against the declared Phase9 G1
+  * snapshot. Its scripted synthesis copies only a retrieved publication count for verification.
+  */
+final class OfflineComposition(
+    config: ServiceConfig,
+    remoteGraph: Option[GraphEndpoints] = None,
+    remoteSemantic: Option[SemanticEndpoints] = None,
+    sharedMetrics: Option[ServiceMetrics] = None
+) {
+  val sessions = new InMemoryQuerySessionStore
+  val evidence = new InMemoryIndexedEvidenceBundleStore
+  val audits = new InMemoryRuntimeAuditStore
+  val metrics = sharedMetrics.getOrElse(new ServiceMetrics)
+  private val fixture = RuntimeOfflineFixture
+  private val runtimeConfig = fixture.config.copy(retrievalMode = RetrievalMode.Fused)
+  private val assetsRoot = Iterator
+    .iterate(Path.of("").toAbsolutePath)(_.getParent)
+    .takeWhile(_ != null)
+    .map(_.resolve("prompts"))
+    .find(Files.isDirectory(_))
+  private val localMetrics = fixture.metricStore()
+  private val graphNodes = fixture.names.map(n =>
+    GraphNode(
+      fixture.id(n),
+      SchemaVersions.domain,
+      GraphNodeClass.Researcher,
+      n,
+      Vector.empty,
+      fixture.provenance
+    )
+  )
+  private val graphEdges = fixture.edges.map { e =>
+    val source = GraphSourceEvidence.Work(e.representativeWorkIds.head)
+    GraphEdge(
+      e.edgeId,
+      SchemaVersions.domain,
+      e.researcherA,
+      GraphEdgeType.CoauthoredWith,
+      e.researcherB,
+      fixture.policy,
+      source,
+      Vector(NamedText("windowId", "all-years")),
+      None,
+      fixture.provenance
+    )
+  }
+  val graph: GraphEndpoints = remoteGraph.getOrElse(
+    new GraphApi(
+      new InMemoryGraphSnapshot("synthetic-phase9-g1-v1", graphNodes, graphEdges, localMetrics),
+      BootstrapConfig.graph(sys.env)
+    )
+  )
+  private val embedding = new DeterministicHashedEmbeddingClient(
+    EmbeddingModel("synthetic-offline-services", "v1", 8)
+  )
+  private val vectors = new InMemoryVectorStore
+  private val index = "synthetic-offline-services-v1"
+  vectors.ensureIndex(index, 8, "cosine")
+  val semantic: SemanticEndpoints =
+    remoteSemantic.getOrElse(SemanticApi.fromPorts(embedding, embedding.model, vectors, index))
+  val extended = ExtendedApi(new EvidenceApi(evidence, audits, Some(sessions)), graph, semantic)
+
+  val workflow: QueryWorkflow = new QueryWorkflow {
+    def run(
+        request: QueryRequest,
+        context: RequestContext,
+        stage: String => Unit
+    ): Either[ApiError, WorkflowOutput] = {
+      if (request.question != "Synthetic fixture: publication count for A")
+        return Left(ApiError.unsupported)
+      val assets = assetsRoot
+        .toRight(ApiError.unavailable)
+        .flatMap(p =>
+          RuntimePromptAssets.fromDirectory(p, runtimeConfig).left.map(_ => ApiError.unavailable)
+        )
+      assets.flatMap { prompts =>
+        val metricPort = new ResearcherMetricStore {
+          def put(r: ResearcherMetricRecord) = StorageResult.Rejected("read-only-runtime")
+          def get(id: String, window: String): StorageResult[ResearcherMetricRecord] =
+            remoteGraph match {
+              case None => localMetrics.get(id, window)
+              case Some(g) =>
+                g.metrics(id, window, context) match {
+                  case Left(_) => StorageResult.Rejected("remote-metrics-unavailable")
+                  case Right(reply) =>
+                    val body = reply.body
+                    StorageResult.Found(
+                      ResearcherMetricRecord(
+                        id,
+                        window,
+                        body("metricVersion").str,
+                        body("runId").str,
+                        body("record").render(),
+                        body("qualifications").render()
+                      )
+                    )
+                }
+            }
+          def batchGet(
+              keys: Vector[(String, String)]
+          ): StorageResult[Vector[ResearcherMetricRecord]] = {
+            val values = keys.map((id, w) => get(id, w))
+            if (values.forall(StorageResult.successful))
+              StorageResult.Found(values.flatMap(StorageResult.value))
+            else StorageResult.Rejected("remote-metrics-unavailable")
+          }
+        }
+        val semanticVectors: VectorStore = remoteSemantic
+          .map { remote =>
+            new VectorStore {
+              def ensureIndex(n: String, d: Int, m: String) =
+                StorageResult.Rejected("read-only-runtime")
+              def putBatch(n: String, ds: Vector[VectorDocument]) =
+                StorageResult.Rejected("read-only-runtime")
+              def get(n: String, keys: Vector[String]): StorageResult[Vector[VectorDocument]] =
+                StorageResult.Found(Vector.empty)
+              def query(n: String, v: Vector[Float], k: Int, f: Map[String, String])
+                  : StorageResult[Vector[VectorHit]] = remote.retrieve(
+                ujson
+                  .Obj(
+                    "question" -> request.question,
+                    "topK" -> k,
+                    "filters" -> ujson.Obj.from(f.map((key, value) => key -> ujson.Str(value)))
+                  )
+                  .render(),
+                context
+              ) match {
+                case Left(_) => StorageResult.Rejected("remote-semantic-unavailable")
+                case Right(reply) =>
+                  StorageResult.Found(
+                    reply
+                      .body("hits")
+                      .arr
+                      .toVector
+                      .map(h =>
+                        VectorHit(
+                          h("key").str,
+                          h("distance").num,
+                          h("metadata").obj.toMap.map((key, value) => key -> value.str)
+                        )
+                      )
+                  )
+              }
+            }
+          }
+          .getOrElse(vectors)
+        val model = new LlmClient {
+          def complete(r: StructuredLlmRequest): LlmResult = {
+            val body = ujson.read(r.userData)
+            val contextJson = ujson.read(
+              body("evidenceData").str
+                .stripPrefix("<untrusted_evidence_json>\n")
+                .stripSuffix("\n</untrusted_evidence_json>")
+            )
+            val item = contextJson("items").arr.find(
+              _.obj.get("values").exists(_.obj.contains("publicationCount"))
+            )
+            item match {
+              case None => LlmResult.Failure("synthetic-count-evidence-unavailable")
+              case Some(ev) =>
+                val raw = ev("values")("publicationCount")
+                val value = raw.strOpt.getOrElse(raw.render())
+                val claim = ujson.Obj(
+                  "claimId" -> "synthetic-publication-count",
+                  "claimType" -> "METRIC",
+                  "subjectIds" -> ujson.Arr(fixture.id("A")),
+                  "values" -> ujson.Arr(
+                    ujson.Obj(
+                      "field" -> "publicationCount",
+                      "number" -> value,
+                      "text" -> ujson.Null,
+                      "ids" -> ujson.Null,
+                      "flag" -> ujson.Null
+                    )
+                  ),
+                  "evidenceIds" -> ujson.Arr(ev("evidenceId")),
+                  "windowIds" -> ujson.Arr("all-years"),
+                  "templateId" -> "metric-v1"
+                )
+                LlmResult.Output(
+                  ujson
+                    .Obj(
+                      "schemaVersion" -> runtimeConfig.synthesisSchemaVersion,
+                      "claims" -> ujson.Arr(claim),
+                      "narrativeClaimIds" -> ujson.Arr("synthetic-publication-count"),
+                      "interpretation" -> "",
+                      "uncertainty" -> "Declared synthetic offline G1 fixture only."
+                    )
+                    .render(),
+                  LlmUsage(None, None),
+                  runtimeConfig.model.modelId,
+                  runtimeConfig.model.modelVersion
+                )
+            }
+          }
+        }
+        val retrieval = new WorkflowRunner(
+          new QueryPlannerAgent(new ScriptedLlmClient(Vector.empty), runtimeConfig, prompts),
+          new ResearcherResolverAgent(fixture.cache(), runtimeConfig),
+          new CollaborationMetricsAgent(metricPort, fixture.artifacts(), runtimeConfig),
+          new PathFinderAgent(fixture.graph(), metricPort, fixture.artifacts(), runtimeConfig),
+          new CommunityAnalystAgent(
+            fixture.graph(),
+            metricPort,
+            fixture.artifacts(),
+            runtimeConfig
+          ),
+          new SemanticContextAgent(
+            semanticVectors,
+            new InMemoryObjectStore,
+            embedding,
+            index,
+            runtimeConfig
+          ),
+          new EvidenceBuilderAgent(evidence, runtimeConfig),
+          runtimeConfig
+        )
+        val full = new RuntimeAnswerWorkflow(
+          retrieval,
+          new AnswerSynthesisAgent(model, runtimeConfig, prompts),
+          new ClaimVerificationAgent(runtimeConfig),
+          audits,
+          runtimeConfig
+        )
+        val adapter = new RuntimeWorkflowAdapter(
+          full,
+          (req, _) =>
+            Right(
+              fixture
+                .plan(QueryOperation.MaximumTeamSize, "A")
+                .copy(
+                  question = req.question,
+                  runtime = Some(
+                    RuntimeQueryOptions(
+                      researcherNames = Vector("A"),
+                      windowIds = Vector("all-years"),
+                      retrievalMode = RetrievalMode.Fused,
+                      evidenceOnly = false
+                    )
+                  )
+                )
+            ),
+          Some(evidence)
+        )
+        adapter.run(request, context, stage)
+      }
+    }
+  }
+  def ready: Boolean =
+    assetsRoot.nonEmpty && graph.ready(RequestContext("readiness", "readiness")) && semantic.ready(
+      RequestContext("readiness", "readiness")
+    )
+  val queries = new QueryService(sessions, workflow, config, metrics)
+}
