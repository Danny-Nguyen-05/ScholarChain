{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AssumeOnlyBillingRoleWithMFA",
            "Effect": "Allow",
            "Action": [
                "sts:AssumeRole"
            ],
            "Resource": [
                "arn:aws:iam::530332961125:role/scholarchain-billing-deployer"
            ],
            "Condition": {
                "Bool": {
                    "aws:MultiFactorAuthPresent": "true"
                }
            }
        }
    ]
}
