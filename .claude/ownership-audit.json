{
  "note": "Machine-checkable representative path audit. docs/agents.md remains authoritative; unknown paths require human routing.",
  "patterns": {
    "factory-engineer": ["AGENTS.md", "CLAUDE.md", "docs/agents.md", "docs/agent-runs/README.md", ".claude/**", ".mcp.json"],
    "build-engineer": ["build.sbt", "project/**", ".scalafmt.conf", ".gitignore", "compose.yaml", ".claude/.last-test-run"],
    "domain-engineer": ["modules/core/**"],
    "dataset-engineer": ["datasets/**"],
    "hadoop-engineer": ["modules/hadoop/**"],
    "entity-resolution-engineer": ["modules/entity-resolution/**"],
    "spark-engineer": ["modules/spark/**"],
    "storage-engineer": ["modules/storage/**"],
    "rag-engineer": ["modules/rag/**", "prompts/runtime/**", "prompts/schemas/**"],
    "service-engineer": ["modules/services/**"],
    "test-engineer": ["tests/**"],
    "code-reviewer": [],
    "infra-engineer": ["infra/terraform/**", "scripts/**", ".github/workflows/**"],
    "deploy-engineer": [],
    "experiment-engineer": ["experiments/**", "load-tests/**"],
    "documentation-engineer": ["README.md", "docs/**", "reports/**"],
    "incident-responder": ["docs/incidents/**"],
    "dependency-updater": []
  },
  "exclusions": {
    "documentation-engineer": ["docs/agents.md", "docs/agent-runs/**", "docs/incidents/**"],
    "factory-engineer": [".claude/.last-test-run"]
  },
  "samples": {
    "AGENTS.md": "factory-engineer",
    "CLAUDE.md": "factory-engineer",
    "docs/agents.md": "factory-engineer",
    "docs/agent-runs/README.md": "factory-engineer",
    ".claude/agents/spark-engineer.md": "factory-engineer",
    ".claude/hooks/guard-dangerous.sh": "factory-engineer",
    ".claude/commands/deploy.md": "factory-engineer",
    ".claude/settings.json": "factory-engineer",
    ".claude/.last-test-run": "build-engineer",
    ".mcp.json": "factory-engineer",
    "build.sbt": "build-engineer",
    "project/plugins.sbt": "build-engineer",
    ".gitignore": "build-engineer",
    "modules/core/src/main/scala/Record.scala": "domain-engineer",
    "modules/core/src/test/scala/RecordSpec.scala": "domain-engineer",
    "datasets/dataset-manifest.yaml": "dataset-engineer",
    "modules/hadoop/src/test/scala/JobSpec.scala": "hadoop-engineer",
    "modules/entity-resolution/src/main/scala/Match.scala": "entity-resolution-engineer",
    "modules/spark/src/main/scala/Graph.scala": "spark-engineer",
    "modules/storage/src/main/scala/Neptune.scala": "storage-engineer",
    "modules/rag/src/main/scala/Verifier.scala": "rag-engineer",
    "prompts/runtime/query.md": "rag-engineer",
    "modules/services/src/main/scala/Api.scala": "service-engineer",
    "tests/adversarial/injection.md": "test-engineer",
    "infra/terraform/main.tf": "infra-engineer",
    "scripts/deploy.sh": "infra-engineer",
    "experiments/elasticity.yaml": "experiment-engineer",
    "load-tests/requests.json": "experiment-engineer",
    "README.md": "documentation-engineer",
    "docs/architecture.md": "documentation-engineer",
    "reports/final.md": "documentation-engineer",
    "docs/incidents/incident-001.md": "incident-responder"
  },
  "routes": {
    "constitution": "factory-engineer",
    "build": "build-engineer",
    "domain": "domain-engineer",
    "dataset": "dataset-engineer",
    "hadoop": "hadoop-engineer",
    "identity": "entity-resolution-engineer",
    "graph": "spark-engineer",
    "storage": "storage-engineer",
    "rag": "rag-engineer",
    "service": "service-engineer",
    "test": "test-engineer",
    "review": "code-reviewer",
    "infrastructure": "infra-engineer",
    "deployment": "deploy-engineer",
    "experiment": "experiment-engineer",
    "documentation": "documentation-engineer",
    "incident": "incident-responder",
    "dependency": "dependency-updater"
  }
}
