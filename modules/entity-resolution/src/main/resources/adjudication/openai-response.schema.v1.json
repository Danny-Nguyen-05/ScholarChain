{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scholarchain.adjudication-response.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestHash",
    "pairId",
    "sourceId",
    "targetId",
    "inputEvidenceHash",
    "policyHash",
    "outcome",
    "reasonCodes",
    "evidenceRefs",
    "rationale",
    "reportedConfidence",
    "fieldRefs"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "scholarchain.adjudication-response.v1"
      ]
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pairId": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "inputEvidenceHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policyHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "accept",
        "reject",
        "abstain"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "SUPPORTED_SAME_IDENTITY",
          "SUPPORTED_DIFFERENT_IDENTITY",
          "INSUFFICIENT_EVIDENCE"
        ]
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fieldRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Allowed evidence record ref followed by # and a verified JSON pointer to a present input field"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "reportedConfidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
