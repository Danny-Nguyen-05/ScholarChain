    "scoredWeights": {"name": 0.35, "initials": 0.05, "coauthorOverlap": 0.3, "affiliation": 0.2, "authorOrder": 0.1},
    "featureGroups": {"name": "name", "initials": "name", "authorOrder": "name", "coauthorOverlap": "context", "affiliation": "affiliation"},
